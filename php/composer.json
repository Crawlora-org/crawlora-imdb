{
  "name": "crawlora/imdb",
  "description": "Crawlora IMDb API client with 30 endpoints for title and name search, charts, ratings, credits, awards, episodes, reviews, images, and title metadata",
  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "imdb",
    "imdb-api",
    "imdb-scraper",
    "imdb-data",
    "imdb-title-name-search",
    "imdb-charts",
    "imdb-ratings",
    "imdb-credits",
    "imdb-awards",
    "imdb-episodes",
    "imdb-reviews",
    "imdb-images",
    "imdb-title-metadata"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Imdb\\": "src/Crawlora/Imdb/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Imdb\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=imdb-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-imdb",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=imdb-php-api-docs"
  }
}
